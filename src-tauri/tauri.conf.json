{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolCheckout",
  "mainBinaryName": "ToolCheckout",
  "version": "0.1.0",
  "identifier": "com.toolcheckout.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "ToolCheckout",
    "category": "Utility",
    "shortDescription": "Tool checkout for a repair shop",
    "longDescription": "Fast, accountable tool checkout and return tracking for a repair shop counter PC.",
    "copyright": "ToolCheckout contributors",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "ToolCheckout"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
